# Copy to .env (inside pmp_agent/) or export in your shell. NEVER commit real API keys.

# Provider selection: auto | openai | groq | offline
# auto (default): OpenAI if OPENAI_API_KEY is set (wins even if GROQ_API_KEY is also set),
#                 Groq if only GROQ_API_KEY is set, otherwise offline demo mode.
PMP_PROVIDER=auto

# OpenAI credentials (placeholder - uncomment and replace locally to enable OpenAI)
# OPENAI_API_KEY=your-openai-api-key-here
# Optional OpenAI-compatible base URL:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Groq credentials (placeholder - uncomment and replace locally to enable Groq)
# GROQ_API_KEY=your-groq-api-key-here
# Optional Groq base URL (default: https://api.groq.com/openai/v1):
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional model & runtime tuning
# PMP_MODEL=qwen/qwen3.8-27b
# PMP_STRUCTURED_OUTPUT=json_object   # json_schema | json_object | prompt
# PMP_MAX_OUTPUT_TOKENS=1500
# PMP_WORKER_MAX_TOKENS=600
# PMP_LLM_MAX_ATTEMPTS=2
# PMP_PROVIDER_RETRIES=2              # bounded retries for transient 429/timeout/connection (0-3)
# PMP_ITPM_LIMIT=5500                 # sliding-window input tokens/min limit (0 disables)
# PMP_OTPM_LIMIT=900                  # sliding-window output tokens/min limit (0 disables)
# PMP_REASONING_EFFORT=none           # none | minimal | low | medium | high
# PMP_TOKEN_PARAM=max_tokens          # max_tokens | max_completion_tokens
# PMP_TRACING=false                   # true only when using OpenAI and wanting SDK tracing

# Optional durable session persistence (disabled by default -> in-memory)
# PMP_PERSIST_SESSIONS=false
# PMP_SESSION_DB_PATH=.pmp_sessions/sessions.db

# Local UI server binding
# GRADIO_SERVER_NAME=127.0.0.1
# PORT=7860
